---
layout: none
---
[
  {% for post in site.pages %}
    {
      "title"    : "{{ post.title | escape }}",
      "category" : "{{ post.navCategory }}",
      "image"    : "{{ post.image }}",
      "descript" : "{{ post.description }}",
      "tags"     : "{{ post.tags | join: ', ' }}",
      "url"      : "{{ site.baseurl }}{{ post.url }}",
      "date"     : "{{ post.date }}"
    } {% unless forloop.last %},{% endunless %}
  {% endfor %}
  ,
  {% for post in site.documents %}
    {
      "title"    : "{{ post.title | escape }}",
      "category" : "{{ post.navCategory }}",
      "image"    : "{{ post.images[0].image | post.page_blocks[0].image | post.page_blocks[1].image | post.page_blocks[2].image}}",
      "descript" : "{{ post.description | strip_html | strip_newlines | remove_chars | truncate: 156 | escape }}",
      "tags"     : "{{ post.tags | join: ', ' }}",
      "url"      : "{{ site.baseurl }}{{ post.url }}",
      "date"     : "{{ post.date }}"
    } {% unless forloop.last %},{% endunless %}
  {% endfor %}
]